LOGAN_SECRET_KEY=replace-with-at-least-32-characters
LOGAN_DATABASE_PATH=.logan/logan.db
LOGAN_LOCAL_OBJECT_STORE_DIR=.logan/object-store
LOGAN_MAX_UPLOAD_BYTES=314572800
LOGAN_WEB_BASE_URL=http://localhost:3000
LOGAN_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

LOGAN_SSO_AUTHORIZE_URL=
LOGAN_SSO_TOKEN_URL=
LOGAN_SSO_CLIENT_ID=

LOGAN_LLM_PROVIDER=none

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# =============================================================================
# LogAn complete environment reference for the current API + web architecture.
#
# Copy this file to .env when you want every supported option documented in
# one place. Active values match .env.example and start a deterministic local
# stack. Optional settings are commented with their code defaults or an empty
# placeholder.
#
# The API reads process environment variables only; it does not parse .env
# itself. scripts\local.ps1 and scripts\local.bat load it on Windows. On
# macOS/Linux use: set -a; source .env; set +a
#
# This file intentionally contains no settings for removed Redis, S3/MinIO,
# ClickHouse, OpenSearch, Temporal, OpenTelemetry, or Kubernetes integrations.
# =============================================================================

# -----------------------------------------------------------------------------
# Core runtime.
# production enables secure cookies and validates production-only invariants.
# LOGAN_API_WORKERS is consumed by the API container command, not Settings.
# -----------------------------------------------------------------------------
LOGAN_ENV=development
#LOGAN_LOG_LEVEL=INFO
#LOGAN_API_WORKERS=1

# -----------------------------------------------------------------------------
# Application and credential-encryption keys.
# Production keys must be non-default values with at least 32 characters.
# The keyring is a JSON object mapping historical key IDs to key material.
# -----------------------------------------------------------------------------
#LOGAN_SECRET_KEY=change-me
#LOGAN_CREDENTIAL_ENCRYPTION_KEY=change-me-local-key
#LOGAN_CREDENTIAL_ENCRYPTION_KEY_ID=default
#LOGAN_CREDENTIAL_ENCRYPTION_KEYRING={}

# -----------------------------------------------------------------------------
# Database and local files.
# PostgreSQL uses the same SQLAlchemy implementation as SQLite.
# Step-artifact failure mode is `warn` or `fail`.
# -----------------------------------------------------------------------------
LOGAN_DATABASE_URL=sqlite:///.logan/logan.db
#LOGAN_DATABASE_URL=postgresql+psycopg://logan:logan@localhost:5432/logan
LOGAN_LOCAL_OBJECT_STORE_DIR=.logan/object-store
#LOGAN_STEP_ARTIFACT_FAILURE_MODE=warn

# -----------------------------------------------------------------------------
# Model provider.
# mock is deterministic and network-free. ai_platform is the real provider.
# -----------------------------------------------------------------------------
LOGAN_LLM_PROVIDER=mock
#LOGAN_AI_PLATFORM_MODEL=gpt-5.4
#LOGAN_AI_PLATFORM_REASONING_EFFORT=high

# Chat endpoint.
#LOGAN_AI_PLATFORM_CHAT_HOST=
#LOGAN_AI_PLATFORM_CHAT_URI=/v1/api/v1/chat/completions

# Authentication option 1: direct trust token.
# LOGAN_AI_PLATFORM_TOKEN_EXPIRES_AT accepts an ISO-8601 timestamp.
#LOGAN_AI_PLATFORM_TOKEN=
#LOGAN_AI_PLATFORM_TOKEN_EXPIRES_AT=

# Authentication option 2: exchange iB2B credentials for a trust token.
#LOGAN_AI_PLATFORM_USERNAME=
#LOGAN_AI_PLATFORM_PASSWORD=
#LOGAN_AI_PLATFORM_USERCASE=
#LOGAN_AI_PLATFORM_IB2B_HOST=
#LOGAN_AI_PLATFORM_IB2B_URI=/dsp/rest-sts/DSP_iB2B/iB2B_tokenTranslator_v2?_action=translate

# Model request behavior.
#LOGAN_AI_PLATFORM_TRUST_TOKEN_HEADER=X-XXXX-E2E-Trust-Token
#LOGAN_AI_PLATFORM_TRACKING_PREFIX=EFP
#LOGAN_AI_PLATFORM_MAX_COMPLETION_TOKENS=4096
#LOGAN_AI_PLATFORM_STORE_COMPLETIONS=false
#LOGAN_AI_PLATFORM_TOKEN_TTL_SECONDS=30
#LOGAN_AI_PLATFORM_TIMEOUT_SECONDS=120

# TLS and proxy behavior. The CA bundle falls back to SSL_CERT_FILE and then
# REQUESTS_CA_BUNDLE. When trust-env is true, httpx also honors standard proxy
# variables. TLS verification cannot be disabled in production.
#LOGAN_AI_PLATFORM_TLS_VERIFY=true
#LOGAN_AI_PLATFORM_CA_BUNDLE=
#LOGAN_AI_PLATFORM_PROXY_URL=
#LOGAN_AI_PLATFORM_TRUST_ENV=true
#SSL_CERT_FILE=
#REQUESTS_CA_BUNDLE=
#HTTPS_PROXY=
#HTTP_PROXY=
#ALL_PROXY=
#NO_PROXY=

# -----------------------------------------------------------------------------
# Sign-in.
# LogAn is SSO-only. The active values use the built-in local mock endpoints.
# Production must use real provider URLs and LOGAN_SSO_MOCK_ENABLED=false.
# -----------------------------------------------------------------------------
LOGAN_SSO_ENABLED=true
LOGAN_SSO_MOCK_ENABLED=true
LOGAN_SSO_AUTHORIZE_URL=http://localhost:8000/api/auth/sso/mock/authorize
LOGAN_SSO_TOKEN_URL=http://localhost:8000/api/auth/sso/mock/token
LOGAN_SSO_MOCK_USERNAME=logan.local
LOGAN_SSO_MOCK_EMAIL=logan.local@example.com
LOGAN_SSO_MOCK_FULL_NAME="Logan Local User"
#LOGAN_SSO_CLIENT_ID=webapp
#LOGAN_SSO_AUTHORIZE_SCOPE="read write"
#LOGAN_SSO_TOKEN_SCOPE=offline_access
#LOGAN_SSO_TLS_VERIFY=true
#LOGAN_SSO_TIMEOUT_SECONDS=15

# -----------------------------------------------------------------------------
# Retention windows in days.
# -----------------------------------------------------------------------------
#LOGAN_RAW_LOG_RETENTION_DAYS=30
#LOGAN_REPORT_RETENTION_DAYS=365
#LOGAN_AUDIT_RETENTION_DAYS=730

# -----------------------------------------------------------------------------
# Metrics.
# -----------------------------------------------------------------------------
#LOGAN_METRICS_ENABLED=true
#LOGAN_METRICS_PATH=/metrics

# -----------------------------------------------------------------------------
# Browser-facing URLs.
# NEXT_PUBLIC_API_BASE_URL is inlined into the web bundle at build time.
# LOGAN_CORS_ALLOWED_ORIGINS accepts a comma-separated list.
# -----------------------------------------------------------------------------
LOGAN_CORS_ALLOWED_ORIGINS=http://localhost:3000
LOGAN_WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# SCIM provisioning.
# When a bearer token is set, SCIM requests are scoped to one organization.
# -----------------------------------------------------------------------------
#LOGAN_SCIM_BEARER_TOKEN=
#LOGAN_SCIM_ORGANIZATION_ID=default

# -----------------------------------------------------------------------------
# Demo and screenshot script overrides. These are tool settings, not API
# Settings fields.
# -----------------------------------------------------------------------------
#LOGAN_DEMO_API_BASE_URL=http://localhost:8000
#LOGAN_DEMO_WEB_BASE_URL=http://localhost:3000

# .env is copied from this template and sourced by POSIX shells
# (`set -a; source .env`), which break on CRLF line endings. Keep it LF
# on every platform; the Windows dev script tolerates either ending.
.env.example text eol=lf

# cmd.exe is only fully reliable with CRLF batch files (labels and multi-line
# blocks can misparse under LF), so pin them regardless of checkout platform.
*.bat text eol=crlf

# Shell scripts are executed inside Linux containers and break under CRLF.
*.sh text eol=lf
